{
  "name": "cortico-world-delta",
  "version": "1.1.0",
  "description": "让 Coo 可以按固定频率观察三角洲的击杀和保险箱。",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/kyrsi/cortico-world-delta.git"
  },
  "keywords": ["cortico-world", "delta-force", "三角洲观察"],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./protocol": "./src/protocol.ts"
  },
  "files": [
    "src", "scripts", "dist", "knowledge", "documents",
    "describe.json", "README*.md", "LICENSE"
  ],
  "engines": { "node": ">=22" },
  "os": ["win32"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --import tsx --test \"tests/*.test.mjs\"",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "cortico": "0.2.17",
    "esbuild": "0.28.2",
    "jpeg-js": "0.4.4",
    "jsdom": "30.1.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "tags": ["game", "external-setup", "sensitive-data"],
    "displayName": "三角洲观察",
    "locales": {
      "zh": {
        "displayName": "三角洲观察",
        "description": "让 Coo 可以按固定频率观察三角洲的击杀和保险箱。"
      },
      "en": {
        "displayName": "Game observer",
        "description": "Let Coo check kill notifications and the safe box in Delta Force at regular intervals."
      }
    },
    "webUiClient": "dist/console.js",
    "webUiStyle": "dist/console.css",
    "describe": "describe.json"
  }
}
